# Copy to tools/.env and fill in. tools/.env is never committed or deployed.
# NASA Earthdata: https://urs.earthdata.nasa.gov  -> Profile -> Generate Token
EARTHDATA_TOKEN=
# PurpleAir: https://develop.purpleair.com  -> create a READ key
PURPLEAIR_API_KEY=
# CourtListener: https://www.courtlistener.com/profile/api/  -> API token
COURTLISTENER_TOKEN=
